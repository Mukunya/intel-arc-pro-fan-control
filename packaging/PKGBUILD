# Maintainer: Mukunya
#
# Build from this directory:
#   makepkg -si
#
# The kernel version follows Arch's linux package. Update pkgver and pkgrel
# from the matching Arch PKGBUILD when refreshing the kernel.

pkgbase=intel-arc-pro-fan-control
pkgname=("$pkgbase" "linux-xe-fan" "linux-xe-fan-headers")
pkgver=7.2.11.arch1
pkgrel=1
pkgdesc='Intel Arc Pro fan control, GPU tuning, and patched xe kernel'
arch=('x86_64')
url='https://github.com/Mukunya/intel-arc-pro-fan-control'
license=('MIT')
makedepends=(
  'bc' 'bison' 'cpio' 'elfutils' 'flex' 'git' 'kmod' 'libelf'
  'openssl' 'pahole' 'patch' 'python' 'rsync' 'tar' 'xz' 'zstd'
)

_srcname="linux-${pkgver%.*}"
_srctag="v${pkgver%.*}-${pkgver##*.}"

source=(
  "https://cdn.kernel.org/pub/linux/kernel/v${pkgver%%.*}.x/${_srcname}.tar.xz"
  "https://github.com/archlinux/linux/releases/download/${_srctag}/linux-${_srctag}.patch.zst"
  "https://gitlab.archlinux.org/archlinux/packaging/packages/linux/-/raw/main/config.x86_64"
  "xe-fan-control-168027-cachyos-7.1.2.patch::file://${startdir}/../patch/xe-fan-control-168027-cachyos-7.1.2.patch"
  "xe_gt_oc.c::file://${startdir}/../kernel/xe_gt_oc.c"
  "xe_gt_oc.h::file://${startdir}/../kernel/xe_gt_oc.h"
  "linux-xe-fan.install"
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')
install='linux-xe-fan.install'

prepare() {
  cd "$srcdir/$_srcname"

  echo "-$pkgrel" > localversion.10-pkgrel
  echo "-xe-fan" > localversion.20-pkgname

  if [[ -f "$srcdir/linux-${_srctag}.patch.zst" ]]; then
    unzstd -c "$srcdir/linux-${_srctag}.patch.zst" | patch -Np1
  fi

  cp "$srcdir/config.x86_64" .config
  make olddefconfig

  patch -p1 --fuzz=5 -i "$srcdir/xe-fan-control-168027-cachyos-7.1.2.patch"

  local xe='drivers/gpu/drm/xe'
  cp "$srcdir/xe_gt_oc.c" "$srcdir/xe_gt_oc.h" "$xe/"

  python - "$xe" <<'PY'
import sys
from pathlib import Path

xe = Path(sys.argv[1])

makefile = xe / "Makefile"
text = makefile.read_text()
if "xe_gt_oc.o" not in text:
    lines = text.splitlines(keepends=True)
    for index, line in enumerate(lines):
        if "xe_gt_freq.o" in line:
            indent = line[:len(line) - len(line.lstrip())]
            lines.insert(index + 1, f"{indent}xe_gt_oc.o \\\n")
            break
    else:
        raise SystemExit("xe_gt_freq.o anchor not found in xe Makefile")
    makefile.write_text("".join(lines))

gt = xe / "xe_gt.c"
text = gt.read_text()
if '#include "xe_gt_oc.h"' not in text:
    anchor = '#include "xe_gt_freq.h"\n'
    if anchor not in text:
        raise SystemExit("xe_gt_freq.h include not found")
    text = text.replace(anchor, anchor + '#include "xe_gt_oc.h"\n', 1)

if "xe_gt_oc_init(gt)" not in text:
    anchor = "\terr = xe_gt_freq_init(gt);\n\tif (err)\n\t\treturn err;\n"
    if anchor not in text:
        raise SystemExit("xe_gt_freq_init anchor not found")
    text = text.replace(
        anchor,
        anchor + "\n\terr = xe_gt_oc_init(gt);\n\tif (err)\n\t\treturn err;\n",
        1,
    )
gt.write_text(text)
PY
}

build() {
  cd "$srcdir/$_srcname"
  make olddefconfig
  make -s kernelrelease > version
  make -j"$(nproc)" bzImage modules
}

_install_kernel() {
  local dest="$1"
  cd "$srcdir/$_srcname"
  local krel
  krel="$(<version)"

  install -Dm644 "arch/x86/boot/bzImage" \
    "$dest/usr/lib/modules/$krel/vmlinuz"
  install -Dm644 System.map "$dest/usr/lib/modules/$krel/System.map"
  install -Dm644 .config "$dest/usr/lib/modules/$krel/config"
  echo "$pkgbase" > "$dest/usr/lib/modules/$krel/pkgbase"

  ZSTD_CLEVEL=19 make INSTALL_MOD_PATH="$dest/usr" \
    INSTALL_MOD_STRIP=1 DEPMOD=/doesnt/exist modules_install
  rm -f "$dest/usr/lib/modules/$krel/build"
}

package_intel-arc-pro-fan-control() {
  pkgdesc='Userland utilities and GTK4 GUI for Intel Arc Pro fan control'
  depends=(
    'gtk4' 'libadwaita' 'polkit' 'python' 'python-gobject' 'python-cairo'
    'systemd'
  )
  optdepends=(
    'desktop-file-utils: update the desktop application cache'
    'kexec-tools: B70 resizable-BAR workaround'
  )
  backup=(
    'etc/xe-fan-curve.conf'
    'etc/xe-gpu-oc.conf'
    'etc/xe-gpu-tune.conf'
  )

  install -d "$pkgdir/usr/bin" "$pkgdir/usr/sbin"
  for name in xe-fan-curve xe-gpu-tune xe-gpu-temps xe-gpu xe-gpu-oc \
              xe-gpu-stress xe-gpu-vramd; do
    install -Dm755 "$startdir/../scripts/$name.sh" "$pkgdir/usr/bin/$name"
  done
  if [[ -f "$startdir/../scripts/setup-llm-benchmark.sh" ]]; then
    install -Dm755 "$startdir/../scripts/setup-llm-benchmark.sh" \
      "$pkgdir/usr/bin/xe-gpu-benchmark-setup"
  fi
  install -Dm755 "$startdir/../gui/xe-gpu-gui.py" \
    "$pkgdir/usr/bin/xe-gpu-gui"
  install -Dm755 "$startdir/../scripts/xe-b70-rebar-kexec.sh" \
    "$pkgdir/usr/sbin/xe-b70-rebar-kexec"

  install -Dm644 "$startdir/../gui/xe-gpu-gui.desktop" \
    "$pkgdir/usr/share/applications/xe-gpu-gui.desktop"
  install -Dm644 "$startdir/../polkit/49-xe-gpu.rules" \
    "$pkgdir/etc/polkit-1/rules.d/49-xe-gpu.rules"
  sed -i 's#/usr/local/bin#/usr/bin#g; s#/usr/local/sbin#/usr/sbin#g' \
    "$pkgdir/etc/polkit-1/rules.d/49-xe-gpu.rules"
  sed -i '/xe-fan-rebuild/d' "$pkgdir/etc/polkit-1/rules.d/49-xe-gpu.rules"

  for file in "$startdir"/../systemd/*.service; do
    install -Dm644 "$file" \
      "$pkgdir/usr/lib/systemd/system/$(basename "$file")"
  done
  sed -i 's#/usr/local/bin#/usr/bin#g; s#/usr/local/sbin#/usr/sbin#g' \
    "$pkgdir"/usr/lib/systemd/system/*.service
  for file in "$startdir"/../systemd/etc/*.conf; do
    install -Dm644 "$file" "$pkgdir/etc/$(basename "$file")"
  done
}

package_linux-xe-fan() {
  pkgdesc='Arch kernel with the Intel Arc Pro fan and VF-curve xe patches'
  depends=('coreutils' 'kmod' 'mkinitcpio')
  optdepends=('linux-xe-fan-headers: build external modules for this kernel')
  install='linux-xe-fan.install'

  _install_kernel "$pkgdir"

  local krel
  krel="$(<"$srcdir/$_srcname/version")"
  install -Dm644 "$startdir/../LICENSE" \
    "$pkgdir/usr/share/licenses/linux-xe-fan/LICENSE"
  install -Dm644 /dev/null "$pkgdir/etc/mkinitcpio.d/linux-xe-fan.preset"
  cat > "$pkgdir/etc/mkinitcpio.d/linux-xe-fan.preset" <<EOF
ALL_config="/etc/mkinitcpio.conf"
ALL_kver="$krel"
PRESETS=('default' 'fallback')
default_image="/boot/initramfs-linux-xe-fan.img"
fallback_options="-S autodetect"
fallback_image="/boot/initramfs-linux-xe-fan-fallback.img"
EOF
}

package_linux-xe-fan-headers() {
  pkgdesc='Headers and prepared source for the linux-xe-fan kernel'
  depends=('linux-xe-fan')

  cd "$srcdir/$_srcname"
  local krel
  krel="$(<version)"
  local builddir="$pkgdir/usr/lib/modules/$krel/build"
  install -d "$pkgdir/usr/src/linux-xe-fan-$krel"
  rsync -a --delete \
    --exclude='.git' \
    "$srcdir/$_srcname/" "$pkgdir/usr/src/linux-xe-fan-$krel/"
  ln -s "/usr/src/linux-xe-fan-$krel" "$builddir"
  ln -s "/usr/src/linux-xe-fan-$krel" \
    "$pkgdir/usr/lib/modules/$krel/source"
}
