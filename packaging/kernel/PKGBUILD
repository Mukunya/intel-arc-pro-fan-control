# Maintainer: Mukunya
#
# Build from this directory:
#   makepkg -si

pkgname=intel-xe-oc-dkms
pkgver=0.1.0
pkgrel=2
pkgdesc='DKMS package for patched Intel xe fan control and VF-curve overclocking'
arch=('x86_64')
url='https://github.com/Mukunya/intel-arc-pro-fan-control'
license=('MIT')
depends=('dkms' 'bash')
makedepends=('patch' 'python')
source=(
  "dkms.conf::file://${startdir}/../../dkms/dkms.conf"
  "dkms-build.sh::file://${startdir}/../../dkms/dkms-build.sh"
  "xe-fan-control-168027-cachyos-7.1.2.patch::file://${startdir}/../../patch/xe-fan-control-168027-cachyos-7.1.2.patch"
  "xe_gt_oc.c::file://${startdir}/../../kernel/xe_gt_oc.c"
  "xe_gt_oc.h::file://${startdir}/../../kernel/xe_gt_oc.h"
)
sha256sums=('SKIP' 'SKIP' 'SKIP' 'SKIP' 'SKIP')

package() {
  local modname='intel-xe-oc'
  local moddir="$pkgdir/usr/src/${modname}-${pkgver}"

  install -d "$moddir/patch" "$moddir/kernel"

  install -Dm755 "$srcdir/dkms-build.sh" "$moddir/dkms-build.sh"
  install -Dm644 "$srcdir/xe-fan-control-168027-cachyos-7.1.2.patch" \
    "$moddir/patch/xe-fan-control-168027-cachyos-7.1.2.patch"
  install -Dm644 "$srcdir/xe_gt_oc.c" "$moddir/kernel/xe_gt_oc.c"
  install -Dm644 "$srcdir/xe_gt_oc.h" "$moddir/kernel/xe_gt_oc.h"

  sed \
    -e "s/^PACKAGE_NAME=.*/PACKAGE_NAME=\"${modname}\"/" \
    -e "s/^PACKAGE_VERSION=.*/PACKAGE_VERSION=\"${pkgver}\"/" \
    "$srcdir/dkms.conf" > "$moddir/dkms.conf"

  install -Dm644 "$startdir/../../LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
