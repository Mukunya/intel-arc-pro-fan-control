_regenerate_initramfs() {
  local module_dir krel found=0

  for module_dir in /usr/lib/modules/*; do
    [[ -f "$module_dir/pkgbase" ]] || continue
    [[ "$(<"$module_dir/pkgbase")" == linux-xe-fan ]] || continue

    krel="${module_dir##*/}"
    depmod -a "$krel"
    found=1
  done

  (( found )) && mkinitcpio -p linux-xe-fan
}

post_install() {
  command -v depmod >/dev/null 2>&1 || return 0
  command -v mkinitcpio >/dev/null 2>&1 || return 0
  _regenerate_initramfs
}

post_upgrade() {
  post_install
}

post_remove() {
  rm -f /boot/initramfs-linux-xe-fan.img \
        /boot/initramfs-linux-xe-fan-fallback.img
}
